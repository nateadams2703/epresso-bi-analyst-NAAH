# Copy this to .streamlit/secrets.toml for local work (that file is git-ignored).
# On Streamlit Community Cloud, paste the same lines into App settings > Secrets.
# Never commit the real key, and never paste it into an AI chat.
GEMINI_API_KEY = "paste-your-key-here"

# Optional: use a different Gemini model (default: gemini-3.5-flash-lite).
# GEMINI_MODEL = "gemini-3.5-flash-lite"
